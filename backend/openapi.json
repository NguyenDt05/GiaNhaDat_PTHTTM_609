{
  "openapi": "3.1.0",
  "info": {
    "title": "House Price Prediction API",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readiness Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions": {
      "post": {
        "tags": [
          "predictions"
        ],
        "summary": "Predict",
        "operationId": "predict_api_v1_predictions_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/options": {
      "get": {
        "tags": [
          "model"
        ],
        "summary": "Options",
        "operationId": "options_api_v1_options_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Options Api V1 Options Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/model": {
      "get": {
        "tags": [
          "model"
        ],
        "summary": "Model Metadata",
        "operationId": "model_metadata_api_v1_model_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Model Metadata Api V1 Model Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Direction": {
        "type": "string",
        "enum": [
          "NORTH",
          "NORTHEAST",
          "EAST",
          "SOUTHEAST",
          "SOUTH",
          "SOUTHWEST",
          "WEST",
          "NORTHWEST"
        ],
        "title": "Direction"
      },
      "EstimatedPrice": {
        "properties": {
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "default": "billion_vnd"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "EstimatedPrice"
      },
      "FurnitureState": {
        "type": "string",
        "enum": [
          "FULL",
          "BASIC"
        ],
        "title": "FurnitureState"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LegalStatus": {
        "type": "string",
        "enum": [
          "CERTIFICATE",
          "SALE_CONTRACT"
        ],
        "title": "LegalStatus"
      },
      "ModelReference": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "training_data_version": {
            "type": "string",
            "title": "Training Data Version"
          }
        },
        "type": "object",
        "required": [
          "version",
          "training_data_version"
        ],
        "title": "ModelReference"
      },
      "PredictionRequest": {
        "properties": {
          "area_m2": {
            "type": "number",
            "maximum": 5000.0,
            "exclusiveMinimum": 0.0,
            "title": "Area M2"
          },
          "frontage_m": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 500.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frontage M"
          },
          "access_road_width_m": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 500.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Road Width M"
          },
          "floors": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Floors"
          },
          "bedrooms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bedrooms"
          },
          "bathrooms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bathrooms"
          },
          "house_direction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Direction"
              },
              {
                "type": "null"
              }
            ]
          },
          "balcony_direction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Direction"
              },
              {
                "type": "null"
              }
            ]
          },
          "legal_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LegalStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "furniture_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FurnitureState"
              },
              {
                "type": "null"
              }
            ]
          },
          "province_code": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Province Code"
          },
          "district_code": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "District Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "area_m2",
          "province_code",
          "district_code"
        ],
        "title": "PredictionRequest"
      },
      "PredictionResponse": {
        "properties": {
          "prediction_id": {
            "type": "string",
            "title": "Prediction Id"
          },
          "estimated_price": {
            "$ref": "#/components/schemas/EstimatedPrice"
          },
          "model": {
            "$ref": "#/components/schemas/ModelReference"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/WarningItem"
            },
            "type": "array",
            "title": "Warnings"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "prediction_id",
          "estimated_price",
          "model",
          "warnings",
          "request_id"
        ],
        "title": "PredictionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WarningItem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "WarningItem"
      }
    }
  }
}